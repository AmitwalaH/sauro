# Rust, Node and Python build output
/target/
/node_modules/
__pycache__/
*.log
.env
.DS_Store

# Stored third-party pages stay on the labeler's machine (owner decision Q25). The fixture
# JSON records each page's URL, fetch date and sha256; answer.md is ours and is committed.
# The pattern must be `*.sources/*`, not `*.sources/`: git cannot re-include a file inside
# an ignored folder, so the folder form silently drops answer.md too.
bench/fixtures/*.sources/*
!bench/fixtures/*.sources/answer.md

# Markers read by the git-gate hook, if ported from doriki
/.gate-ok

# The owner's method and task files are provided outside version control.
/METHOD.md
/tasks/
